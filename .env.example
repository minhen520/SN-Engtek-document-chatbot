# Copy this file to .env and fill in your key
OPENAI_API_KEY=sk-...

# Optional: LM Studio local LLM (OpenAI-compatible server)
# LM_STUDIO_URL=http://127.0.0.1:1234/v1
# LM_STUDIO_MODEL=your-model-id

# Optional overrides
# RAG_CHAT_MODEL=gpt-4o-mini
# RAG_VECTOR_STORE_NAME=rag-app-store
# RAG_MAX_RESULTS=8

# Optional: enable web search for general questions when your documents
# don't contain the answer.
#
# 1) Get a Tavily API key: https://tavily.com
# 2) Set both variables below
#
# TAVILY_API_KEY=tvly-...
# RAG_WEB_SEARCH_ENABLED=1
# RAG_TAVILY_MAX_RESULTS=5
